{
  "name": "campus-ride",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:seed:local": "node scripts/local-db.mjs seed",
    "db:reset:local": "node scripts/local-db.mjs reset",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build",
    "deploy:staging": "node scripts/check-deploy.mjs staging",
    "deploy:production": "node scripts/check-deploy.mjs production"
  },
  "dependencies": {
    "hono": "4.13.14",
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261027.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "wrangler": "$wrangler",
      "miniflare": "5.20261023.0-beta"
    }
  }
}
